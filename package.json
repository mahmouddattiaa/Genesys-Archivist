{
  "name": "genesys-archivist",
  "version": "0.0.0",
  "private": true,
  "description": "Captures Genesys Cloud Architect flows and every resource they depend on, then generates business and technical documentation.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --dry",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:validate": "node scripts/validate-schemas.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run schema:validate",
    "spike:s2": "node scripts/spike/s2-discovery.mjs",
    "spike:s3": "node scripts/spike/s3-references.mjs",
    "spike:s1": "node scripts/spike/s1-fidelity.mjs",
    "spike:s1b": "node scripts/spike/s1b-corpus.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.0.0",
    "fast-check": "^4.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.0.0",
    "purecloud-platform-client-v2": "^259.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.0"
  }
}
