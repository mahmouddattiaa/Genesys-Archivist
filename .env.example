# Phase 0 spike credentials. Copy to .env.phase0 and fill in.
#
#   cp .env.example .env.phase0
#
# .env.phase0 is gitignored by the ".env.*" rule and must NEVER be committed,
# pasted into a chat, printed by a script, or included in a support bundle.
# Spike scripts read it directly and are forbidden from echoing its values.
#
# This file is the ONLY approved channel for the sandbox client secret during
# Phase 0. Once the OS credential store lands (Plan 2), profiles replace it.

# Region enum, not a hostname. Examples: mec1, use1, use2, euw1, euw2, apne1, aps1
GENESYS_REGION=

# OAuth client with the CLIENT CREDENTIALS grant and a read-only role.
# Not a username. Not a password. Never a user login.
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=

# The organization ID you expect to connect to. The spike compares the ID it
# discovers against this value and aborts on mismatch, so a mistyped credential
# cannot silently read the wrong tenant.
GENESYS_EXPECTED_ORG_ID=

# OPTIONAL, and only used by the S4 permission spike.
#
# A correctly scoped read-only client cannot read its own OAuth configuration --
# that needs oauth:client:view, which is credential-adjacent and precisely what
# the gate exists to keep out of the role. So S4 verifies the restricted
# client's granted roles using a second, administrative credential, and probes
# the endpoints using the restricted one. Leave these blank and S4 reports
# INCONCLUSIVE rather than passing on an assertion it could not make.
GENESYS_ADMIN_CLIENT_ID=
GENESYS_ADMIN_CLIENT_SECRET=
