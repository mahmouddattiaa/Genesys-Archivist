# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo
coverage/

# ---------------------------------------------------------------
# CUSTOMER DATA. Never commit any of these.
# Capture bundles are classified `restricted`: they contain endpoint
# URLs, DIDs, routing logic, data-table rows, and prompt audio.
# ---------------------------------------------------------------
# Anchored with a leading slash so they match ONLY at the repository root.
# Unanchored, `documentation/` also matched `packages/documentation/` and made
# that entire source package invisible to git -- it was never committed, and a
# fresh clone would fail `tsc --build` on a referenced directory that was not
# there. The CI job below now fails the build if a package has no tracked files.
/bundles/
/derived/
/documentation/
/.archivist/
*.capture-bundle/
/spike-evidence/

# Raw Architect exports. These are customer configuration: flow logic, queue
# names, prompt text, data-action endpoints. Sanitized derivatives belong in
# fixtures/; the raw export never gets committed.
*.i3flow
/*.yaml
/*.yml
!/.github/**/*.yml
architect-exports/

# Credentials
.env
.env.*
!.env.example
*.pem
*.key

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Playwright
playwright-report/
test-results/
